# ============================================================
#  SIGPROV - Configuracion de entorno del backend
# ============================================================
#  COPIA este archivo a ".env" y ajusta los valores:
#      cp .env.example .env      (Linux/macOS)
#      copy .env.example .env    (Windows CMD)
#
#  El archivo ".env" esta en .gitignore y NO se versiona.
# ============================================================


# ------------------------------------------------------------
#  Base de datos (PostgreSQL)
# ------------------------------------------------------------
SIGPROV_DB_HOST=localhost
SIGPROV_DB_PORT=5432
SIGPROV_DB_USER=sigprov
SIGPROV_DB_PASSWORD=cambiar_esta_password_en_produccion
SIGPROV_DB_NAME=sigprov


# ------------------------------------------------------------
#  API
# ------------------------------------------------------------
SIGPROV_ENVIRONMENT=local
SIGPROV_DEBUG=false

# Origenes permitidos, separados por coma
SIGPROV_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8000,file://


# ------------------------------------------------------------
#  Seguridad
# ------------------------------------------------------------
#  Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SIGPROV_SECRET_KEY=cambiar_esta_clave_por_una_aleatoria_de_48_caracteres_minimo
SIGPROV_JWT_ALGORITHM=HS256
SIGPROV_ACCESS_TOKEN_MINUTES=60
SIGPROV_REFRESH_TOKEN_DAYS=7
SIGPROV_LOGIN_MAX_INTENTOS=5
SIGPROV_LOGIN_BLOQUEO_MINUTOS=15


# ------------------------------------------------------------
#  Machine Learning
# ------------------------------------------------------------
SIGPROV_ML_MIN_DIAS_ENTRENAMIENTO=60
SIGPROV_ML_PREDICCION_DIAS_DEFAULT=7
